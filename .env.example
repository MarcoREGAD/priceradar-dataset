# Copie ce fichier en .env et renseigne les deux valeurs.
# Ce sont celles que le site public expose deja dans ses pages : la cle anon
# n'ouvre que l'acces en lecture dont le site se sert lui-meme.
#
# N'utilise JAMAIS la cle service_role : elle contourne les regles de securite
# au niveau des lignes et n'a rien a faire ici.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Linux uniquement : permet au conteneur d'ecrire des fichiers qui
# t'appartiennent. `echo "UID=$(id -u)" >> .env`
# UID=1000
# GID=1000

# Publication depuis un serveur, profil `serveur` uniquement.
# DATASET_REPO_URL=https://github.com/OWNER/priceradar-dataset.git
# GITHUB_TOKEN=
