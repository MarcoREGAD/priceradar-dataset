# Copie en .env, ou saisis ces variables dans l'interface de ton hebergeur.
#
# ---------------------------------------------------------------------------
# Source des donnees — obligatoire
# ---------------------------------------------------------------------------
# Les deux valeurs que le site public expose deja dans ses pages : la cle anon
# n'ouvre que l'acces en lecture dont le site se sert lui-meme.
# N'utilise JAMAIS la cle service_role, elle contourne la securite par ligne.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Depot a mettre a jour — obligatoire
# ---------------------------------------------------------------------------
# Le conteneur clone ce depot au premier demarrage et le garde dans son volume.
# Le jeton doit pouvoir ecrire dans ce depot, et seulement dans celui-la :
# un jeton fin (fine-grained) limite a ce depot, permission "Contents: Read and
# write", est le bon choix.
DATASET_REPO_URL=https://github.com/OWNER/priceradar-dataset.git
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Comportement — optionnel, les valeurs ci-dessous sont les defauts
# ---------------------------------------------------------------------------
# Creneaux UTC. Le collecteur tourne vers 07:00 et 15:00 : ces horaires passent
# peu apres, et celui de minuit rattrape une collecte en retard.
# UPDATE_TIMES=08:20,16:20,00:30

# Mise a jour des le demarrage, pour verifier un deploiement sans attendre.
# RUN_ON_START=true

# Passe a false pour un service a blanc : il regenere et valide sans rien
# pousser. Utile pour un premier deploiement d'observation.
# PUSH=true

# Identite des commits automatiques.
# GIT_AUTHOR_NAME=priceradar-bot
# GIT_AUTHOR_EMAIL=priceradar-bot@users.noreply.github.com
